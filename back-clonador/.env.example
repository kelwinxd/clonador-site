# Porta da API
PORT=3000

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Libera IPs de rede interna na trava de SSRF.
# SÓ em desenvolvimento, para clonar as páginas de teste em 127.0.0.1.
# Em produção isto precisa ficar de fora ou como false.
ALLOW_PRIVATE_HOSTS=false

# Fila da Etapa 6
REDIS_URL=redis://localhost:6379

# Fila
CLONE_CONCURRENCY=5
# Quanto tempo o zip fica disponível para download (ms)
RESULT_TTL_MS=1800000

# Onde ficam os navegadores do Playwright.
# Use PLAYWRIGHT_BROWSERS_PATH=0 (dentro do node_modules) se o seu Node virtualizar a
# pasta AppData\Local (Node da Microsoft Store, por exemplo) e o navegador "sumir".
# Depois de definir, rode:  PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install chromium
# Em produção (imagem Docker do Playwright) NÃO defina isto — os navegadores já vêm na imagem.
# PLAYWRIGHT_BROWSERS_PATH=0

# Limite de taxa do POST /clone (protege contra abuso/custo com a página aberta).
# Padrão: 10 clones por hora por IP.
RATE_LIMIT=10
RATE_TTL_MS=3600000
# Saltos de proxy confiáveis para pegar o IP real. Railway = 1.
TRUST_PROXY=1

# Banco (Etapa 10). Local = Postgres do docker-compose. Produção = URL do Postgres do Railway.
DATABASE_URL=postgresql://clonador:clonador@localhost:5433/clonador?schema=public
